rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidCheck(data) {
      return data.keys().hasAll(['id', 'createdAt', 'aiAnswer', 'trustScore']) &&
        data.id is string && data.id.size() <= 128 &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        data.aiAnswer is string && data.aiAnswer.size() <= 50000 &&
        data.trustScore is number && data.trustScore >= 0 && data.trustScore <= 100;
    }

    match /hallu_checks/{checkId} {
      allow read: if isValidId(checkId);
      allow create: if isValidId(checkId) && isValidCheck(incoming());
      allow update, delete: if false;
    }
  }
}
